{
  "manifest_version": 3,
  "name": "letxcook — grade any X draft",
  "version": "0.3.0",
  "description": "Grade your X drafts against 13 engagement signals before posting. Adds an 'Audit' button to every post and opens a quick verdict in-place.",
  "action": {
    "default_title": "letxcook — audit this post"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://letxcook.com/*"
  ],
  "permissions": ["activeTab", "declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "letxcook_csp",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
