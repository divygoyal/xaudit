# ─────────────────────────────────────────────────────────────
# xAudit env template. Copy to .env.local for dev, set the same
# keys in your hosting provider (Vercel) for production.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# Gemini (live grading). Without it, /api/analyze returns the canned sample.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase project — anon + service-role keys.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth — used by both "Continue with Google" and Google One Tap.
# The Client ID is public (it appears in the OAuth redirect URL anyway).
# Console: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public site origin — used by OG-image and referral-link generation.
# Local dev: leave unset (defaults to http://localhost:3000).
# Production: https://xaudit.app (or your Vercel deployment URL).
NEXT_PUBLIC_SITE_URL=
